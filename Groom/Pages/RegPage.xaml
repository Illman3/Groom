<Page x:Class="Groom.Pages.RegPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:charts="clr-namespace:System.Windows.Forms.DataVisualization.Charting;assembly=System.Windows.Forms.DataVisualization"
      xmlns:local="clr-namespace:Groom.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="61*" />
            <ColumnDefinition Width="739*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="45" />
            <RowDefinition Height="*" />
            <RowDefinition Height="45" />
        </Grid.RowDefinitions>
        <Label Grid.Column="1"
            Content="Введите логин"
            HorizontalAlignment="Left"
            Margin="91,13,0,0"
            Grid.Row="1"
            VerticalAlignment="Top"
            Width="128" />
        <Label Content="Выберите роль"
            HorizontalAlignment="Left"
            Margin="91,177,0,0"
            Grid.Row="1"
            VerticalAlignment="Top"
            Width="128"
            Grid.Column="1" />
        <Label Grid.Column="1"
            Content="Подтвердите пароль"
            HorizontalAlignment="Left"
            Margin="91,118,0,0"
            Grid.Row="1"
            VerticalAlignment="Top"
            Width="169" />
        <Label Grid.Column="1"
            Content="Введите пароль"
            HorizontalAlignment="Left"
            Margin="91,65,0,0"
            Grid.Row="1"
            VerticalAlignment="Top"
            Width="128" />
        <Label Grid.Column="1"
            Content="Введите ФИО"
            HorizontalAlignment="Left"

            Margin="91,250,0,0"
            Grid.Row="1"
            VerticalAlignment="Top"
            Width="128" />
        <TextBox x:Name="txtbxLog"
            Background="Transparent"
            ToolTip="Введите логин или почту"
            Grid.Column="1"
            HorizontalAlignment="Left"
            Margin="339,13,0,0"
            Grid.Row="1"
            TextWrapping="Wrap"
            VerticalAlignment="Top"
            Width="182"
            Height="29"/>
        <TextBox x:Name="txtbxFIO"
            Background="Transparent"
            ToolTip="Введите ФИО"
            Grid.Column="1"
            Margin="339,243,0,0"
            Grid.Row="1"
            TextWrapping="Wrap"
            Height="43"
            VerticalAlignment="Top"
            HorizontalAlignment="Left"
            Width="182"/>

        <PasswordBox x:Name="passBxFrst"
            Background="Transparent"
            ToolTip="Введите пароль"
            Grid.Column="1"
            HorizontalAlignment="Left"
            Margin="339,65,0,0"
            Grid.Row="1"
            VerticalAlignment="Top"
            Width="182"
            Height="33"/>
        <PasswordBox x:Name="passBxScnd"
            Background="Transparent"
            ToolTip="Повторите пароль"
            Grid.Column="1"
            HorizontalAlignment="Left"
            Margin="339,118,0,0"
            Grid.Row="1"
            VerticalAlignment="Top"
            Width="182"
            Height="33"/>
        <ComboBox x:Name="comboBxRole"
            Grid.Column="1"
            ToolTip="Выберите роль"
            HorizontalAlignment="Left"
            Margin="339,180,0,0"
            Grid.Row="1"

            VerticalAlignment="Top"
            Width="182"
            RenderTransformOrigin="0.144,0.522"
            Height="37" SelectionChanged="comboBxRole_SelectionChanged">
        </ComboBox>
        <Label x:Name="lblLogHitn"
               IsHitTestVisible="False"  
               ToolTip="Нажмите, чтобы ввести логин"
            Foreground="Gray"
            Grid.Column="1"
            Content="Введите логин"
            HorizontalAlignment="Left"
            Margin="339,13,0,0"
            Grid.Row="1"
            VerticalAlignment="Top"
            Width="182"
               MouseLeftButtonUp="lblLogHitn_MouseLeftButtonUp"
            Height="29" />
        <Label x:Name="lblPassHitn"
               IsHitTestVisible="False"  
            Foreground="Gray"
               ToolTip="Нажмите, чтобы ввести пароль"
               MouseLeftButtonUp="lblLogHitn_MouseLeftButtonUp"
            Grid.Column="1"
            Content="Введите пароль"
            HorizontalAlignment="Left"
            Margin="339,67,0,0"
            Grid.Row="1"
            VerticalAlignment="Top"
            Width="182"
            Height="29" />
        <Label x:Name="lblPassSecHitn"
               IsHitTestVisible="False"  
            Foreground="Gray"
               ToolTip="Нажмите, чтобы повторить пароль"
               MouseLeftButtonUp="lblLogHitn_MouseLeftButtonUp"
            Grid.Column="1"
            Content="Повторите пароль"
            HorizontalAlignment="Left"
            Margin="339,118,0,0"
            Grid.Row="1"
            VerticalAlignment="Top"
            Width="182"
            Height="33" />
        <Label x:Name="lblFioHitn"
               IsHitTestVisible="False"  
            Foreground="Gray"
               ToolTip="Нажмите, чтобы ввести ФИО"
               MouseLeftButtonUp="lblLogHitn_MouseLeftButtonUp"
            Grid.Column="1"
            Content="Введите ФИО"
            HorizontalAlignment="Left"
            Margin="339,244,0,0"
            Grid.Row="1"
            VerticalAlignment="Top"
            Width="182"
            Height="42" />
        <Button x:Name="regButton"
            Grid.Column="1"
                ToolTip="Нажмите для завершения регистрации"
            Content="Зарегистрироваться"
            HorizontalAlignment="Left"
            Margin="345,302,0,0"
            Grid.Row="1"
            VerticalAlignment="Top"
            RenderTransformOrigin="0.535,-0.075"
            Width="170"
            Click="regButton_Click" />
    </Grid>
</Page>
