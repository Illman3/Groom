<Page x:Class="Groom.Pages.AddServicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:charts="clr-namespace:System.Windows.Forms.DataVisualization.Charting;assembly=System.Windows.Forms.DataVisualization"
      xmlns:local="clr-namespace:Groom.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddServicePage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Название услуги" Grid.Row="0" Grid.Column="0" Margin="10" FontSize="16" VerticalAlignment="Center"/>
        <TextBlock Text="Цена" Grid.Row="1" Grid.Column="0" Margin="10" FontSize="16" VerticalAlignment="Center"/>
        <TextBlock Text="Длительность (мин)" Grid.Row="2" Grid.Column="0" Margin="10" FontSize="16" VerticalAlignment="Center"/>
        <TextBlock Text="Описание" Grid.Row="3" Grid.Column="0" Margin="10" FontSize="16" VerticalAlignment="Center"/>

        <TextBox x:Name="TBServiceName" Grid.Row="0" Grid.Column="1" Margin="10" Height="30"/>
        <TextBox x:Name="TBPrice" Grid.Row="1" Grid.Column="1" Margin="10" Height="30"/>
        <TextBox x:Name="TBDuration" Grid.Row="2" Grid.Column="1" Margin="10" Height="30"/>
        <TextBox x:Name="TBDescription" Grid.Row="3" Grid.Column="1" Margin="10" Height="60" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="ButtonSave" Content="Сохранить" Width="120" Height="35" Margin="10" Click="ButtonSave_Click"/>
            <Button x:Name="ButtonClean" Content="Очистить" Width="120" Height="35" Margin="10" Click="ButtonClean_Click"/>
        </StackPanel>
    </Grid>
</Page>