<Page x:Class="Groom.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:charts="clr-namespace:System.Windows.Forms.DataVisualization.Charting;assembly=System.Windows.Forms.DataVisualization"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UserPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
            <TextBlock Text="Поиск по логину:" FontSize="12" VerticalAlignment="Center"/>
            <TextBox x:Name="fioFilterTextBox" Margin="7,0,0,0" MinWidth="150" Height="25"
                     TextChanged="fioFilterTextBox_TextChanged"/>

            <TextBlock Text="Сортировка:" Margin="15,0,0,0" FontSize="12" VerticalAlignment="Center"/>
            <ComboBox x:Name="sortComboBox" Margin="7,0,0,0" Width="130" Height="25" SelectedIndex="0"
                      SelectionChanged="sortComboBox_SelectionChanged">
                <ComboBoxItem Content="По возрастанию"/>
                <ComboBoxItem Content="По убыванию"/>
            </ComboBox>

            <CheckBox x:Name="onlyAdminCheckBox" Content="Только администраторы" Margin="15,0,0,0"
                      VerticalContentAlignment="Center" IsChecked="False"
                      Checked="onlyAdminCheckBox_Checked" Unchecked="onlyAdminCheckBox_Unchecked"/>

            <Button x:Name="clearFiltersButton" Content="Очистить фильтр" Margin="15,0,0,0"
                    Height="25" Width="110" Click="clearFiltersButton_Click_1"/>
        </WrapPanel>

        <ListView x:Name="ListUser" Grid.Row="1" BorderThickness="0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="8" Margin="5" Padding="10" Width="220" Background="White">
                        <StackPanel HorizontalAlignment="Center">

                            <Image Width="100" Height="100" Source="/Images/ava.png" Stretch="UniformToFill" Margin="0,0,0,10"/>

                            <TextBlock Text="{Binding Login}" FontSize="16" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,5"/>

                            <TextBlock FontSize="14" Foreground="Gray" TextAlignment="Center">
                                <Run Text="Роль ID: "/>
                                <Run Text="{Binding RoleID}"/>
                            </TextBlock>

                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>